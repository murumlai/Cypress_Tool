<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scope package restore for this solution to nuget.org so builds do not depend on the
    machine's private Azure DevOps feeds (which are not always reachable).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
