<Window x:Class="Fx3I2cProgrammer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cypress FX3 I2C EEPROM Programmer"
        Height="720" Width="960"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Device -->
            <RowDefinition Height="Auto" />  <!-- Firmware -->
            <RowDefinition Height="Auto" />  <!-- Settings -->
            <RowDefinition Height="Auto" />  <!-- Actions -->
            <RowDefinition Height="Auto" />  <!-- Progress -->
            <RowDefinition Height="*" />     <!-- Log -->
            <RowDefinition Height="Auto" />  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Device selection -->
        <GroupBox Grid.Row="0" Header="1. Target device" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsIdle}"
                          VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh" Margin="6,0,0,0"
                        Command="{Binding RefreshDevicesCommand}" />
                <Button Grid.Column="2" Content="Probe"
                        Command="{Binding ProbeCommand}" />
            </Grid>
        </GroupBox>

        <!-- Firmware -->
        <GroupBox Grid.Row="1" Header="2. Firmware image" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding FirmwarePath, Mode=OneWay}"
                         IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                        Command="{Binding BrowseFirmwareCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding FirmwareSummary}" Margin="0,6,0,0"
                           Foreground="#444" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- EEPROM settings -->
        <GroupBox Grid.Row="2" Header="3. EEPROM settings" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,6" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsIdle}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="I2C address" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Grid.Row="0" Grid.Column="3" Width="90" Margin="0,0,0,6"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Capacity (bytes)" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                         Text="{Binding CapacityBytes, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Page size" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Grid.Row="1" Grid.Column="3" Width="90" Margin="0,0,0,6"
                         Text="{Binding PageSizeBytes, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Addressing" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,0"
                          ItemsSource="{Binding AddressingModes}"
                          SelectedItem="{Binding AddressingMode}"
                          IsEnabled="{Binding IsIdle}" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Bank size" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="3" Width="90"
                         Text="{Binding BankSizeBytes, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" />
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Program + Verify" MinWidth="130" FontWeight="SemiBold"
                    Command="{Binding ProgramCommand}" />
            <Button Content="Verify Only" Command="{Binding VerifyCommand}" />
            <Button Content="Erase EEPROM" Command="{Binding EraseCommand}"
                    Background="#F6DADA" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <CheckBox Content="Verify after write" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding VerifyAfterWrite}" IsEnabled="{Binding IsIdle}" />
            <TextBlock Text="{Binding AddressError}" Foreground="#C02828" VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </StackPanel>

        <!-- Progress -->
        <ProgressBar Grid.Row="4" Height="18" Margin="0,0,0,8"
                     Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

        <!-- Operation log -->
        <GroupBox Grid.Row="5" Header="Operation log">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding Log}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="Clear log" HorizontalAlignment="Right" Margin="0,6,0,0"
                        Command="{Binding ClearLogCommand}" />
            </Grid>
        </GroupBox>

        <!-- Status bar -->
        <Border Grid.Row="6" Background="#EEE" Margin="0,8,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
