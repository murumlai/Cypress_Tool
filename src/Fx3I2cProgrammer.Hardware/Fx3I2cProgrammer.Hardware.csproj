<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Fx3I2cProgrammer.Hardware</RootNamespace>
    <AssemblyName>Fx3I2cProgrammer.Hardware</AssemblyName>
    <!-- CyUSB.dll is an x86 (.NET 2.0) assembly, so this project must build x86. -->
    <Platform>x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fx3I2cProgrammer.Core\Fx3I2cProgrammer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the Cypress CyUSB.NET assembly that ships at the repository root. -->
    <Reference Include="CyUSB">
      <HintPath>..\..\CyUSB.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- CyUSB references System.Windows.Forms/Drawing for its device-tree helpers. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
